TrialsAuto.UseLift = function()
    local Enemies =
        workspace:FindFirstChild(
            "enemies"
        )

    if Enemies then
        for _, Enemy in ipairs(
            Enemies:GetChildren()
        ) do
            if ChromaticaInternal.IsEnemyAlive(Enemy) then
                TrialsAuto.ActiveLiftPrompt = nil
                TrialsAuto.NextLiftAttempt = 0
                return false
            end
        end
    end

    local Lift, Prompt =
        TrialsAuto.GetLiftPrompt()

    if not Lift
        or not Prompt
        or not Prompt.Parent
        or not Prompt:IsDescendantOf(workspace)
        or not Prompt.Enabled
        or Prompt.MaxActivationDistance <= 0
    then
        TrialsAuto.ActiveLiftPrompt = nil
        TrialsAuto.NextLiftAttempt = 0
        return false
    end

    if TrialsAuto.ActiveLiftPrompt ~= Prompt then
        TrialsAuto.ActiveLiftPrompt = Prompt
        TrialsAuto.NextLiftAttempt = 0
    end

    local Now = os.clock()

    if Now < TrialsAuto.NextLiftAttempt then
        return true
    end

    TrialsAuto.NextLiftAttempt =
        Now + TrialsAuto.LiftPromptDelay

    local PromptTarget =
        ChromaticaInternal.GetRaidPromptTarget(
            Prompt
        )

    local Root =
        ChromaticaInternal.GetCharacterRoot()

    local TargetCFrame =
        ChromaticaInternal.GetObjectCFrame(
            PromptTarget or Lift
        )

    local NeedsTeleport = true

    if Root and TargetCFrame then
        local Distance =
            (
                Root.Position
                - TargetCFrame.Position
            ).Magnitude

        NeedsTeleport =
            Distance
            > math.max(
                Prompt.MaxActivationDistance
                - 1,
                1
            )
    end

    if NeedsTeleport then
        if PromptTarget then
            ChromaticaInternal.TeleportToObject(
                PromptTarget,
                0
            )
        else
            ChromaticaInternal.TeleportToObject(
                Lift,
                0
            )
        end
    end

    task.defer(function()
        task.wait(0.2)

        if TrialsAuto.ActiveLiftPrompt
                ~= Prompt
            or not Prompt
            or not Prompt.Parent
            or not Prompt:IsDescendantOf(
                workspace
            )
            or not Prompt.Enabled
            or Prompt.MaxActivationDistance <= 0
        then
            return
        end

        ChromaticaInternal.UseRaidExitPrompt(
            Prompt
        )
    end)

    return true
end

function ChromaticaInternal.GetRubbleTagText()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return nil
    end

    local RubbleBar =
        PlayerGui:FindFirstChild(
            "RubbleBar"
        )

    if not RubbleBar then
        return nil
    end

    local Holder =
        RubbleBar:FindFirstChild(
            "Holder"
        )

    if not Holder then
        return nil
    end

    local Tag =
        Holder:FindFirstChild(
            "Tag"
        )

    if not Tag then
        return nil
    end

    local Text = nil

    if Tag:IsA("TextLabel")
        or Tag:IsA("TextButton")
        or Tag:IsA("TextBox")
    then
        Text = Tag.Text

    elseif Tag:IsA("StringValue") then
        Text = Tag.Value
    end

    if not Text then
        return nil
    end

    Text = string.gsub(
        Text,
        "^%s+",
        ""
    )

    Text = string.gsub(
        Text,
        "%s+$",
        ""
    )

    return string.upper(Text)
end

function ChromaticaInternal.IsRubbleBreakable()
    return ChromaticaInternal.GetRubbleTagText()
        == "[BREAK IT]"
end

function ChromaticaInternal.GetActiveBorderBlocker()
    local World =
        workspace:FindFirstChild(
            "World"
        )

    if not World then
        return nil
    end

    local Map =
        World:FindFirstChild(
            "Map"
        )

    if not Map then
        return nil
    end

    for Number = 1, 4 do
        local Border =
            Map:FindFirstChild(
                "Border" .. Number
            )

        if Border then
            local Rubble =
                Border:FindFirstChild(
                    "Rubble"
                )

            local Blocker =
                Border:FindFirstChild(
                    "Blocker"
                )

            if Rubble
                and Blocker
            then
                return Blocker
            end
        end
    end

    return nil
end

function ChromaticaInternal.GetEnemyCountText()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return nil
    end

    local RoundHUD =
        PlayerGui:FindFirstChild(
            "RoundHUD"
        )

    if not RoundHUD then
        return nil
    end

    local Container =
        RoundHUD:FindFirstChild(
            "Container"
        )

    if not Container then
        return nil
    end

    local TopPart =
        Container:FindFirstChild(
            "TopPart"
        )

    if not TopPart then
        return nil
    end

    local RemainingFrame =
        TopPart:FindFirstChild(
            "RemainingFrame"
        )

    if not RemainingFrame then
        return nil
    end

    local EnemyCount =
        RemainingFrame:
            FindFirstChild(
                "EnemyCount"
            )

    if not EnemyCount then
        return nil
    end

    if EnemyCount:IsA(
        "TextLabel"
    )
        or EnemyCount:IsA(
            "TextButton"
        )
        or EnemyCount:IsA(
            "TextBox"
        )
    then
        return EnemyCount.Text
    end

    for _, Object in ipairs(
        EnemyCount:GetDescendants()
    ) do
        if Object:IsA(
            "TextLabel"
        )
            or Object:IsA(
                "TextButton"
            )
            or Object:IsA(
                "TextBox"
            )
        then
            if Object.Text
                and Object.Text ~= ""
            then
                return Object.Text
            end
        end
    end

    return nil
end

function ChromaticaInternal.GetCurrentArea()
    local Text =
        ChromaticaInternal.GetEnemyCountText()

    if not Text then
        return nil
    end

    local AreaNumber =
        string.match(
            string.lower(Text),
            "area%s*(%d+)%s*/%s*5"
        )

    AreaNumber =
        tonumber(AreaNumber)

    if not AreaNumber then
        return nil
    end

    if AreaNumber < 1
        or AreaNumber > 5
    then
        return nil
    end

    return AreaNumber
end

function ChromaticaInternal.GetCurrentInfiniteWave()
    local Text =
        ChromaticaInternal.GetEnemyCountText()

    if not Text then
        return nil
    end

    local Wave =
        string.match(
            string.lower(Text),
            "wave%s*(%d+)"
        )

    Wave =
        tonumber(Wave)

    if not Wave then
        return nil
    end

    if Wave < 1
        or Wave > 999
    then
        return nil
    end

    return Wave
