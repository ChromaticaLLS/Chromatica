                        SavedVolumes[OtherSound] = NewVolume
                    end

                    InternalVolumeChange[OtherSound] = true
                    OtherSound.Volume = 0
                    InternalVolumeChange[OtherSound] = nil
                end)
            end

            InternalVolumeChange[OtherSound] = true
            OtherSound.Volume = 0
            InternalVolumeChange[OtherSound] = nil
        end

        local function RestoreAudio()
            if not Muting then
                return
            end

            Muting = false

            if EndedConnection then
                EndedConnection:Disconnect()
                EndedConnection = nil
            end

            if StoppedConnection then
                StoppedConnection:Disconnect()
                StoppedConnection = nil
