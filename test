    local function SetExcludedPlayers(Value)
        local NewExcludedPlayers =
            {}

        for Entry in string.gmatch(
            tostring(Value or ""),
            "[^,]+"
        ) do
            local Name =
                Entry:gsub("^%s+", ""):
                    gsub("%s+$", "")

            Name =
                string.lower(Name)

            if Name ~= "" then
                NewExcludedPlayers[
                    Name
                ] = true
            end
        end

        ExcludedPlayers =
            NewExcludedPlayers
    end

    local function IsPlayerExcluded(Player)
        if not Player
            or Player == LocalPlayer
        then
            return true
        end

        local Username =
            string.lower(
                tostring(
                    Player.Name
                    or ""
                )
            )

        local DisplayName =
            string.lower(
                tostring(
                    Player.DisplayName
                    or ""
                )
            )

        if ExcludedPlayers[Username]
            or ExcludedPlayers[
                DisplayName
            ]
        then
            return true
        end

        if PlayerDetectorIgnoreFriends then
            local Success,
                IsFriend =
                pcall(function()
                    return LocalPlayer:
                        IsFriendsWith(
                            Player.UserId
                        )
                end)

            if Success
                and IsFriend
            then
                return true
            end
        end

        return false
    end

    local function LeaveForDetectedPlayer()
        if game.PlaceId
            == PlayerDetectorLobbyId
            or PlayerDetectorTriggered
            or not PlayerDetectorEnabled
        then
            return
        end

        PlayerDetectorTriggered =
            true

        local Success =
            pcall(function()
                TeleportService:
                    Teleport(
                        PlayerDetectorLobbyId,
                        LocalPlayer
                    )
            end)

        if not Success then
            PlayerDetectorTriggered =
                false
        end
    end

    local function CheckPlayerDetector()
        if game.PlaceId
            == PlayerDetectorLobbyId
            or not PlayerDetectorEnabled
            or PlayerDetectorTriggered
        then
            return
        end

        for _, Player in ipairs(
            Players:GetPlayers()
        ) do
            if not IsPlayerExcluded(
                Player
            ) then
                LeaveForDetectedPlayer()
                return
            end
        end
    end

