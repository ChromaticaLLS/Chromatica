        RepairConnection =
            RunService.Heartbeat:
                Connect(function()
                    local Camera =
                        workspace.CurrentCamera

                    if not Camera then
                        return
                    end

                    local Viewport =
                        Camera.ViewportSize

                    local MaxWidth =
                        Viewport.X - 64

                    local MaxHeight =
                        Viewport.Y - 64

                    if MaxWidth < 480
                        or MaxHeight < 360
                    then
                        return
                    end

                    local Width =
                        math.min(
                            720,
                            MaxWidth
                        )

                    local Height =
                        math.min(
                            600,
                            MaxHeight
                        )

                    Library.OriginalMinSize =
                        Vector2.new(
                            math.min(
                                480,
                                MaxWidth
                            ),
                            math.min(
                                360,
                                MaxHeight
                            )
                        )

                    Library.MinSize =
                        Vector2.new(
                            math.min(
                                256,
                                MaxWidth
                            ),
                            Library.
                                OriginalMinSize.Y
                        )

                    MainFrame.Size =
                        UDim2.fromOffset(
                            Width,
                            Height
                        )

                    MainFrame.Position =
                        UDim2.new(
                            0.5,
                            -Width / 2,
                            0.5,
                            -Height / 2
                        )

                    pcall(function()
                        Window:
                            SetSidebarWidth(
                                math.ceil(
                                    Width * 0.3
                                )
                            )
                    end)

                    if RepairConnection then
                        RepairConnection:
                            Disconnect()

                        RepairConnection =
                            nil
                    end
                end)

        Library:
            GiveSignal(
                RepairConnection
            )
    end
end


