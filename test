function ChromaticaInternal.HasRaidBossMesh(Boss)
    if not Boss
        or Boss.Name ~= "0"
    then
        return false
    end

    local Cube =
        Boss:FindFirstChild(
            "Cube"
        )

    if not Cube then
        return false
    end

    if Cube:IsA("MeshPart") then
        return RaidBossMeshIds[
            Cube.MeshId
        ] == true
    end

    local Mesh =
        Cube:FindFirstChildOfClass(
            "SpecialMesh"
        )

    if Mesh then
        return RaidBossMeshIds[
            Mesh.MeshId
        ] == true
    end

    return false
end

function ChromaticaInternal.IsIgrisBoss(Enemy)
    if not Enemy then
        return false
    end

    local Asset =
        Enemy:FindFirstChild(
            "Asset"
        )

    return Asset ~= nil
        and Asset:FindFirstChild(
            "Handle_Igris"
        ) ~= nil
end

function ChromaticaInternal.IsIgrisHighlightColor(Color)
    if typeof(Color) ~= "Color3" then
        return false
    end

    return math.floor(
        Color.R * 255 + 0.5
    ) == 220
        and math.floor(
            Color.G * 255 + 0.5
        ) == 20
        and math.floor(
            Color.B * 255 + 0.5
        ) == 40
end

function ChromaticaInternal.IsIgrisTargetable(Enemy)
    if not ChromaticaInternal.IsIgrisBoss(Enemy)
        or not ChromaticaInternal.IsEnemyAlive(Enemy)
    then
        return false
    end

    local HighlightCount = 0
    local IgrisHighlight = nil

    for _, Object in ipairs(
        Enemy:GetDescendants()
    ) do
        if Object:IsA("Highlight") then
            HighlightCount =
                HighlightCount + 1

            IgrisHighlight =
                Object

            if HighlightCount > 1 then
                return false
            end
        end
    end

    if HighlightCount ~= 1
        or not IgrisHighlight
    then
        return false
    end

    local FillColor =
        IgrisHighlight.FillColor

    local IsCyanIgris =
        math.floor(
            FillColor.R * 255 + 0.5
        ) == 0
        and math.floor(
            FillColor.G * 255 + 0.5
        ) == 170
        and math.floor(
            FillColor.B * 255 + 0.5
        ) == 220

    return ChromaticaInternal.IsIgrisHighlightColor(
        FillColor
    )
        or IsCyanIgris
        or ChromaticaInternal.IsIgrisHighlightColor(
            IgrisHighlight.OutlineColor
        )
end

function ChromaticaInternal.IsTargetableRaidBoss(Enemy)
    if ChromaticaInternal.IsIgrisBoss(Enemy) then
        return ChromaticaInternal.IsIgrisTargetable(Enemy)
    end

    return ChromaticaInternal.HasRaidBossMesh(Enemy)
end

function ChromaticaInternal.GetRaidTargetDistance(Enemy)
    if ChromaticaInternal.IsIgrisBoss(Enemy) then
        return 8.3
    end

    if Enemy
        and Enemy.Name == "0"
        and ChromaticaInternal.IsTargetableRaidBoss(
            Enemy
        )
    then
        return RaidBossDistance
    end

    return FarmDistance
end

function ChromaticaInternal.IsRaidBlueIframe(Enemy)
    if not Enemy or not Enemy.Parent then
        return false
    end

    for _, Object in ipairs(Enemy:GetDescendants()) do
        if Object:IsA("Highlight") then
            local FillColor = Object.FillColor
            local OutlineColor = Object.OutlineColor

            local FillIsBlue =
                math.floor(FillColor.R * 255 + 0.5) == 70
                and math.floor(FillColor.G * 255 + 0.5) == 150
                and math.floor(FillColor.B * 255 + 0.5) == 255

            local OutlineIsBlue =
                math.floor(OutlineColor.R * 255 + 0.5) == 70
                and math.floor(OutlineColor.G * 255 + 0.5) == 150
                and math.floor(OutlineColor.B * 255 + 0.5) == 255

            if FillIsBlue or OutlineIsBlue then
                return true
            end
        end
    end

    return false
end

function ChromaticaInternal.IsIgnoredHighlightedRaidBoss(Enemy)
    if ChromaticaInternal.IsIgrisBoss(Enemy) then
        return not ChromaticaInternal.IsIgrisTargetable(
            Enemy
        )
    end

    if Enemy
        and Enemy.Name == "0"
        and ChromaticaInternal.HasRaidBossMesh(Enemy)
    then
        return ChromaticaInternal.IsRaidBlueIframe(Enemy)
    end

    return false
end

