function ChromaticaInternal.IsUltimateGameStateBusy()
    ChromaticaInternal.LoadUltimateControllerModules()

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not Humanoid or Humanoid.Health <= 0 or not Root then
        return true
    end

    local RunStore = UltimateTimer.RunStoreModule
    if RunStore and type(RunStore.isActive) == "function" then
        local Success, Active = pcall(RunStore.isActive, LocalPlayer)
        if Success and not Active then
            return true
        end
    end

    local MouseAim = UltimateTimer.MouseAimModule
    if MouseAim and type(MouseAim.IsAiming) == "function" then
        local Success, Aiming = pcall(MouseAim.IsAiming)
        if Success and Aiming then
            return true
        end
    end

    local ServerNow = workspace:GetServerTimeNow()
    local LocalStoreModule = UltimateTimer.LocalPlayerStoreModule
    local LocalState = LocalStoreModule and LocalStoreModule.state

    if LocalState then
        local SkillState = LocalState.skill
        if SkillState then
            if ChromaticaInternal.ReadUltimateReactiveValue(SkillState.pending) == true then
                return true
            end

            local SkillTill = tonumber(
                ChromaticaInternal.ReadUltimateReactiveValue(SkillState.till)
            ) or 0
            if ServerNow < SkillTill then
                return true
            end
        end

        if ChromaticaInternal.ReadUltimateReactiveValue(LocalState.dashing) == true then
            return true
        end
    end

    local Namespace = UltimateTimer.PlayerNamespaceModule
    if Namespace and type(Namespace.getLocalPlayerStore) == "function" then
        local Success, Store = pcall(function()
            return Namespace.getLocalPlayerStore()
        end)

        if Success and Store and Store.state then
            local State = Store.state
            if ChromaticaInternal.ReadUltimateReactiveValue(State.blocking) == true then
                return true
            end

            if State.stuns and type(State.stuns.getAll) == "function" then
                local StunSuccess, Stuns = pcall(function()
                    return State.stuns:getAll()
                end)

                if StunSuccess and type(Stuns) == "table" then
                    for Key, Stun in pairs(Stuns) do
                        if Key ~= "m1" and Stun and Stun.till then
                            local Till = tonumber(
                                ChromaticaInternal.ReadUltimateReactiveValue(Stun.till)
                            ) or 0
                            if ServerNow < Till then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end

    local InputController = UltimateTimer.InputControllerModule
    if InputController and type(InputController.isBlocked) == "function" then
        local Success, Blocked = pcall(InputController.isBlocked)
        if Success and Blocked then
            return true
        end
    end

    return false
end

