                    )
                end)
            end
        end
    end)

    Library:OnUnload(function()
        if AutoSaveEnabled then
            pcall(function()
                SaveManager:Save(
                    "autosave"
                )
            end)
        end
    end)

end

local SafeSpotConnection =
    RunService.Heartbeat:
        Connect(
            function()
                if not Toggles.SafeSpotEnabled
                    or not Toggles.
                        SafeSpotEnabled.Value
                then
                    SafeSpotActive =
                        false

                    SafeSpotCFrame =
                        nil

                    return
                end

                local Root =
                    ChromaticaInternal.GetCharacterRoot()

                local HealthPercent =
                    ChromaticaInternal.GetHealthPercent()

                if not Root
                    or not HealthPercent
                then
                    return
                end

                if not SafeSpotActive then
                    if HealthPercent
                        <= SafeSpotAwayHP
                    then
                        local SafeEnemy = nil

                        if RaidCurrentTarget
                            and RaidCurrentTarget.Parent
                            and ChromaticaInternal.IsEnemyAlive(
                                RaidCurrentTarget
                            )
                        then
                            SafeEnemy = RaidCurrentTarget
                        elseif CurrentMobTarget
                            and CurrentMobTarget.Parent
                            and ChromaticaInternal.IsEnemyAlive(
                                CurrentMobTarget
                            )
                        then
                            SafeEnemy = CurrentMobTarget
                        elseif Toggles.RaidAutoFarm
                            and Toggles.RaidAutoFarm.Value
                        then
                            SafeEnemy =
                                ChromaticaInternal.GetNearestRaidEnemy()
                        else
                            SafeEnemy =
                                ChromaticaInternal.GetNearestEnemy()
                        end

                        local SafeEnemyRoot =
                            ChromaticaInternal.GetEnemyRoot(
                                SafeEnemy
                            )

                        if SafeEnemyRoot then
                            SafeSpotActive =
                                true

                            SafeSpotCFrame = {
                                Return = Root.CFrame,
                                Enemy = SafeEnemy
                            }
                        end
                    end
                else
                    if HealthPercent
                        >= SafeSpotReturnHP
                    then
                        if SafeSpotCFrame
                            and SafeSpotCFrame.Return
                        then
                            ChromaticaInternal.TweenRootTo(
                                SafeSpotCFrame.Return
                            )

                            if (
                                Root.Position
                                - SafeSpotCFrame.Return.Position
                            ).Magnitude <= 2
                            then
                                ChromaticaInternal.CancelMovementTween()

                                SafeSpotActive =
                                    false

                                SafeSpotCFrame =
                                    nil
                            end
                        else
                            SafeSpotActive =
                                false

                            SafeSpotCFrame =
                                nil
                        end

                        return
                    end

                    local SafeEnemy =
                        SafeSpotCFrame
                        and SafeSpotCFrame.Enemy

                    if not SafeEnemy
                        or not SafeEnemy.Parent
                        or not ChromaticaInternal.IsEnemyAlive(
                            SafeEnemy
                        )
                    then
                        if Toggles.RaidAutoFarm
                            and Toggles.RaidAutoFarm.Value
                        then
                            SafeEnemy =
                                ChromaticaInternal.GetNearestRaidEnemy()
                        else
                            SafeEnemy =
                                ChromaticaInternal.GetNearestEnemy()
                        end

                        if SafeSpotCFrame then
                            SafeSpotCFrame.Enemy =
                                SafeEnemy
                        end
                    end

                    local SafeEnemyRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            SafeEnemy
                        )

                    if SafeEnemyRoot then
                        local SafePosition =
                            SafeEnemyRoot.Position
                            + Vector3.new(
                                0,
                                SafeSpotHeight,
                                0
                            )

                        ChromaticaInternal.TweenRootTo(
                            CFrame.new(
                                SafePosition,
                                SafeEnemyRoot.Position
                            )
                        )
                    end
                end
            end
        )

local AutoFarmConnection =
    RunService.Heartbeat:
        Connect(
            function(DeltaTime)
                if SafeSpotActive then
                    CurrentMobTarget =
                        nil

                    CurrentGateTarget =
                        nil

                    OrbitAngle =
                        0

                    return
                end

                if Toggles.RaidAutoFarm
                    and Toggles.
                        RaidAutoFarm.Value
                then
                    OrbitAngle =
                        0

                    CurrentMobTarget =
                        nil

                    CurrentGateTarget =
                        nil

                    return
                end

                local TrialsEnabled =
                    Toggles.TrialsAutoFarm
                    and Toggles.TrialsAutoFarm.Value

                local NormalFarmEnabled =
                    Toggles.AutoFarm
                    and Toggles.AutoFarm.Value

                if not TrialsEnabled
                    and not NormalFarmEnabled
                then
                    OrbitAngle =
                        0

                    CurrentMobTarget =
                        nil

                    CurrentGateTarget =
                        nil

                    return
                end

                local Root =
                    ChromaticaInternal.GetCharacterRoot()

                if not Root then
                    CurrentMobTarget =
                        nil

                    CurrentGateTarget =
                        nil

                    return
                end

                if TrialsEnabled
                    and TrialsAuto.UseLift()
                then
                    CurrentMobTarget = nil
                    CurrentGateTarget = nil
                    OrbitAngle = 0
                    return
                end

                if CurrentMobTarget
                    and CurrentMobTarget.Parent
                    and ChromaticaInternal.IsEnemyAlive(
                        CurrentMobTarget
                    )
                then
                    local TargetRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            CurrentMobTarget
                        )

                    if TargetRoot then
                        if TrialsEnabled then
                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetRaidAboveCFrame(
                                    TargetRoot,
                                    FarmDistance
                                )
                            )
                        else
                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetFarmCFrame(
                                    TargetRoot,
                                    DeltaTime
                                )
                            )
                        end

                        return
                    end
                end

                CurrentMobTarget =
                    nil

                local Enemy =
                    ChromaticaInternal.GetNearestEnemy()

                if Enemy then
                    local EnemyRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            Enemy
                        )

                    if EnemyRoot then
                        CurrentMobTarget =
                            Enemy

                        CurrentGateTarget =
                            nil

                        if TrialsEnabled then
                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetRaidAboveCFrame(
                                    EnemyRoot,
                                    FarmDistance
                                )
                            )
                        else
                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetFarmCFrame(
                                    EnemyRoot,
                                    DeltaTime
                                )
                            )
                        end

                        return
                    end
                end

                if TrialsEnabled then
                    CurrentGateTarget = nil
                    OrbitAngle = 0
                    return
                end

                if ChromaticaInternal.IsRubbleBreakable() then
                    local Blocker =
                        ChromaticaInternal.GetActiveBorderBlocker()

                    if Blocker then
                        CurrentGateTarget =
                            Blocker

                        ChromaticaInternal.TeleportBehindObject(
                            Blocker,
                            3
                        )

                        return
                    end
                end

                CurrentGateTarget =
                    nil

                local CurrentArea =
                    ChromaticaInternal.GetCurrentArea()

                if CurrentArea then
                    ChromaticaInternal.TeleportToArea(
                        CurrentArea
                    )
                end
            end
        )

local RaidFarmConnection =
    RunService.Heartbeat:
        Connect(
            function()
                if SafeSpotActive then
                    RaidCurrentTarget =
                        nil

                    return
                end

                if not Toggles.RaidAutoFarm
                    or not Toggles.
                        RaidAutoFarm.Value
                then
                    RaidCurrentTarget =
                        nil

                    RaidExitWasEnabled =
                        false

                    RaidResumeAt =
                        0

                    return
                end

                local Root =
                    ChromaticaInternal.GetCharacterRoot()

                if not Root then
                    RaidCurrentTarget =
                        nil

                    return
                end

                local Now =
                    os.clock()

                local Exit,
                    ExitPrompt =
                    ChromaticaInternal.GetRaidExitPrompt()

                if ExitPrompt
                    and ExitPrompt.Parent
                    and ExitPrompt.Enabled
                then
                    RaidExitWasEnabled =
                        true

                    RaidResumeAt =
                        0

                    RaidCurrentTarget =
                        nil

                    local PromptTarget =
                        ChromaticaInternal.GetRaidPromptTarget(
                            ExitPrompt
                        )

                    if PromptTarget then
                        ChromaticaInternal.TeleportToObject(
                            PromptTarget,
                            0
                        )
                    end

                    if Now
                        - LastRaidExitPrompt
                        >= RaidExitPromptDelay
                    then
                        LastRaidExitPrompt =
                            Now

                        ChromaticaInternal.UseRaidExitPrompt(
                            ExitPrompt
                        )
                    end

                    return
                end

                if RaidExitWasEnabled then
                    RaidExitWasEnabled =
                        false

                    RaidResumeAt =
                        Now
                        + RaidTransitionDelay

                    RaidCurrentTarget =
                        nil

                    return
                end

                if RaidResumeAt > 0 then
                    if Now < RaidResumeAt then
                        RaidCurrentTarget =
                            nil

                        return
                    end

                    RaidResumeAt =
                        0
                end

                local SpecialBoss =
                    ChromaticaInternal.GetSpecialRaidBoss()

                if SpecialBoss then
                    if ChromaticaInternal.IsIgrisTargetable(
                        SpecialBoss
                    ) then
                        local BossRoot =
                            ChromaticaInternal.GetEnemyRoot(
                                SpecialBoss
                            )

                        if BossRoot then
                            RaidCurrentTarget =
                                SpecialBoss

                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetRaidAboveCFrame(
                                    BossRoot,
                                    ChromaticaInternal.GetRaidTargetDistance(
                                        SpecialBoss
                                    )
                                )
                            )

                            return
                        end
                    end

                    if RaidCurrentTarget
                        and RaidCurrentTarget.Parent
                        and RaidCurrentTarget.Name
                            ~= "0"
                        and not ChromaticaInternal.IsIgnoredHighlightedRaidBoss(
                            RaidCurrentTarget
                        )
                        and ChromaticaInternal.IsEnemyAlive(
                            RaidCurrentTarget
                        )
                    then
                        local TargetRoot =
                            ChromaticaInternal.GetEnemyRoot(
                                RaidCurrentTarget
                            )

                        if TargetRoot then
                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetRaidAboveCFrame(
                                    TargetRoot,
                                    FarmDistance
                                )
                            )

                            return
                        end
                    end

                    RaidCurrentTarget =
                        nil

                    local Add =
                        ChromaticaInternal.GetNearestRaidAdd()

                    if Add then
                        local AddRoot =
                            ChromaticaInternal.GetEnemyRoot(
                                Add
                            )

                        if AddRoot then
                            RaidCurrentTarget =
                                Add

                            ChromaticaInternal.TweenRootTo(
                                ChromaticaInternal.GetRaidAboveCFrame(
                                    AddRoot,
                                    FarmDistance
                                )
                            )

                            return
                        end
                    end

                    local BossRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            SpecialBoss
                        )

                    if BossRoot then
                        RaidCurrentTarget =
                            SpecialBoss

                        ChromaticaInternal.TweenRootTo(
                            ChromaticaInternal.GetRaidAboveCFrame(
                                BossRoot,
                                ChromaticaInternal.GetRaidTargetDistance(
                                    SpecialBoss
                                )
                            )
                        )

                        return
                    end
                end

                if RaidCurrentTarget
                    and RaidCurrentTarget.Parent
                    and not ChromaticaInternal.IsIgnoredHighlightedRaidBoss(
                        RaidCurrentTarget
                    )
                    and ChromaticaInternal.IsEnemyAlive(
                        RaidCurrentTarget
                    )
                then
                    local TargetRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            RaidCurrentTarget
                        )

                    if TargetRoot then
                        local Distance =
                            ChromaticaInternal.GetRaidTargetDistance(
                                RaidCurrentTarget
                            )

                        ChromaticaInternal.TweenRootTo(
                            ChromaticaInternal.GetRaidAboveCFrame(
                                TargetRoot,
                                Distance
                            )
                        )

                        return
                    end
                end

                RaidCurrentTarget =
                    nil

                local Enemy =
                    ChromaticaInternal.GetNearestRaidEnemy()

                if Enemy then
                    local EnemyRoot =
                        ChromaticaInternal.GetEnemyRoot(
                            Enemy
                        )

                    if EnemyRoot then
                        RaidCurrentTarget =
                            Enemy

                        local Distance =
                            ChromaticaInternal.GetRaidTargetDistance(
                                Enemy
                            )

                        ChromaticaInternal.TweenRootTo(
                            ChromaticaInternal.GetRaidAboveCFrame(
                                EnemyRoot,
                                Distance
                            )
                        )

