TrialsAuto.GetHighestPlayableFloor = function()
    local Deadline = os.clock() + 10

    while not AccountStore
        and os.clock() < Deadline
    do
        task.wait(0.1)
    end

    if not AccountStore
        or not AccountStore.state
        or not AccountStore.state.achievements
        or not AccountStore.state.achievements.progress
    then
        return 1
    end

    local SeasonId = nil

    pcall(function()
        local Config = require(
            ReplicatedStorage
                .assets
                .config
                .LeaderboardSeasonConfig
        )

        if Config
            and Config.Season
        then
            SeasonId = Config.Season.Id
        end
    end)

    if SeasonId == nil then
        return 1
    end

    local function ReadProgress(Key)
        local Value = 0

        pcall(function()
            local Entry =
                AccountStore.state.achievements.progress:
                    get(Key)

            if Entry then
                Value = tonumber(Entry:get()) or 0
            end
        end)

        return Value
    end

    local Prefix =
        "trials.s"
        .. tostring(SeasonId)

    local Room = ReadProgress(
        Prefix .. ".room"
    )

    local Unlocked = ReadProgress(
        Prefix .. ".unlocked"
    )

    return math.max(Room, Unlocked) + 1
end

function ChromaticaInternal.UpdateGamemodeOptions()
    if not Options.QueueAct or not Options.QueueDifficulty then
        return
    end

    local Info = GamemodeInfo[SelectedGamemode]
    local ModeData = Info and Info.ModeData
    local MapData = Info and Info.MapData
    local ActValues = {}
    local DifficultyChoices = {"Easy", "Medium", "Hard", "Nightmare"}
    local IsFloorMode = MapData and MapData.Floors
    local IsStory = SelectedGamemode == "Story"
    local IsRaid = SelectedGamemode == "Raid"
    local HasChapters = IsStory or (MapData and type(MapData.Chapters) == "table")

    if HasChapters then
        local Chapters = MapData and MapData.Chapters
        if type(Chapters) == "table" and #Chapters > 0 then
            for _, Chapter in ipairs(Chapters) do
                table.insert(ActValues, tostring(Chapter))
            end
        else
            ActValues = {"1", "2", "3"}
        end
    elseif IsFloorMode then
        if SelectedGamemode == "Trials" then
            ActValues = {"Auto Highest Floor"}
        else
            for FloorValue = 1, 500 do
                table.insert(ActValues, tostring(FloorValue))
            end
        end
    elseif Info and Info.Maps and #Info.Maps > 1 then
        for _, Candidate in ipairs(Info.Maps) do
            if not Candidate.Floors then
                table.insert(ActValues, Candidate.DisplayName or tostring(Candidate.Id))
            end
        end
    else
        ActValues = {"1"}
    end

    if #ActValues == 0 then
        ActValues = {"1"}
    end

    Options.QueueAct:SetValues(ActValues)

    local ActValue = ActValues[1]
    if HasChapters or (IsFloorMode and SelectedGamemode ~= "Trials") then
        ActValue = tostring(math.clamp(tonumber(SelectedAct) or 1, 1, 500))
        if not table.find(ActValues, ActValue) then
            ActValue = ActValues[1]
        end
        SelectedAct = tonumber(ActValue) or 1
    elseif IsFloorMode and SelectedGamemode == "Trials" then
        ActValue = "Auto Highest Floor"
    elseif Info and Info.MapNames then
        ActValue = Info.MapNames[Info.SelectedMap or Info.Map] or ActValues[1]
        if not table.find(ActValues, ActValue) then
            ActValue = ActValues[1]
        end
    end

    Options.QueueAct:SetValue(ActValue)

    local FixedDifficulty = ModeData and ModeData.FixedDifficulty
    if FixedDifficulty ~= nil then
        local FixedNumber = tonumber(FixedDifficulty)
        local FixedName = ({[1] = "Easy", [2] = "Medium", [3] = "Hard", [4] = "Nightmare"})[FixedNumber]
        if not FixedName and type(FixedDifficulty) == "string" then
            FixedName = FixedDifficulty
        end
        FixedName = FixedName or "Easy"
        DifficultyChoices = {FixedName}
        SelectedDifficulty = FixedName
    elseif IsRaid then
        DifficultyChoices = {"Nightmare"}
        SelectedDifficulty = "Nightmare"
    end

    Options.QueueDifficulty:SetValues(DifficultyChoices)
    if not table.find(DifficultyChoices, SelectedDifficulty) then
        SelectedDifficulty = DifficultyChoices[1]
    end
    Options.QueueDifficulty:SetValue(SelectedDifficulty)
end

function ChromaticaInternal.StartQueue(
    RoomNumber
)
    if not Toggles.QueueAutoJoin
        or not Toggles.QueueAutoJoin.Value
        or not Packets
        or not RoomNumber
    then
        return
    end

    local Info = GamemodeInfo[SelectedGamemode]
    if not Info then
        return
    end

    local MapData = Info.MapData
    local Chapter = 0
    local Floor = 0
    local Map = Info.SelectedMap or Info.Map
    local Difficulty = DifficultyValues[SelectedDifficulty] or 1

    if SelectedGamemode == "Story" or (MapData and MapData.Chapters) then
        Chapter = math.max(1, tonumber(SelectedAct) or 1)
    elseif MapData and MapData.Floors then
        if SelectedGamemode == "Trials" then
            Floor = TrialsAuto.GetHighestPlayableFloor()
        else
            Floor = math.max(1, tonumber(SelectedAct) or 1)
        end
    end

    local FixedDifficulty = Info.ModeData and Info.ModeData.FixedDifficulty
    if FixedDifficulty ~= nil then
        local FixedNumber = tonumber(FixedDifficulty)
        local FixedName = ({[1] = "Easy", [2] = "Medium", [3] = "Hard", [4] = "Nightmare"})[FixedNumber]
        if not FixedName and type(FixedDifficulty) == "string" then
            FixedName = FixedDifficulty
        end
        Difficulty = FixedNumber or DifficultyValues[FixedName] or DifficultyValues[SelectedDifficulty] or Difficulty
    elseif SelectedGamemode == "Raid" then
        Difficulty = 4
    end

    local Payload = {
        gamemode = (Info.ModeData and Info.ModeData.Id) or SelectedGamemode,
        map = Map,
        chapter = Chapter,
        floor = Floor,
        difficulty = Difficulty,
        maxPlayers = MaxPlayers,
        friendsOnly = FriendsOnly,
        roomNumber = RoomNumber
    }

    local StartKey = table.concat({
        tostring(AutoJoinGeneration),
        tostring(Payload.gamemode),
        tostring(Payload.map),
        tostring(Payload.chapter),
        tostring(Payload.floor),
        tostring(Payload.difficulty),
        tostring(Payload.maxPlayers),
        tostring(Payload.friendsOnly),
        tostring(Payload.roomNumber)
    }, ":")

    if GamemodeInfo.LastAutoStartKey == StartKey then
        return
    end

    local Sent = false
    local UsedMatchmaking = false
    local Settings = AccountStore and AccountStore.state and AccountStore.state.settings
    local MatchmakingSetting = Settings and Settings.QueueMatchmaking
    local MatchmakingEnabled = false

    if MatchmakingSetting then
        pcall(function()
            MatchmakingEnabled = MatchmakingSetting:get() == true
        end)
    end

    local MatchRemote = ReplicatedStorage:FindFirstChild("MatchRemote")
    if MatchmakingEnabled
        and not FriendsOnly
        and MaxPlayers > 1
        and not (MapData and MapData.Floors)
        and MatchRemote
        and MatchRemote:IsA("RemoteEvent")
    then
        Sent = pcall(function()
            MatchRemote:FireServer("Start", Payload)
        end)
        UsedMatchmaking = Sent
    end

    if not Sent
        and LocalPlayer:GetAttribute("QueueLeader") ~= true
        and Packets.createQuque
        and type(Packets.createQuque.fire) == "function"
    then
        Sent = pcall(function()
            Packets.createQuque:fire(Payload)
        end)
    end

    if not Sent then
        warn("[Chromatica] Queue request could not be sent for room " .. tostring(RoomNumber))
        return
    end

    GamemodeInfo.LastAutoStartKey = StartKey

    if UsedMatchmaking then
        print("[Chromatica] Auto Lobby: started matchmaking for " .. tostring(SelectedGamemode))
        return
    end

    if Toggles.QueueInstantStart
        and Toggles.QueueInstantStart.Value
        and Packets.startQuqueNow
        and type(Packets.startQuqueNow.fire) == "function"
    then
        if QueueInstantStartConnection then
            pcall(function()
                QueueInstantStartConnection:Disconnect()
            end)
            QueueInstantStartConnection = nil
        end

        local function TryInstantStart()
            if Session ~= getgenv().ChromaticaSession
                or not Toggles.QueueAutoJoin
                or not Toggles.QueueAutoJoin.Value
            then
                if QueueInstantStartConnection then
                    QueueInstantStartConnection:Disconnect()
                    QueueInstantStartConnection = nil
                end
                return
            end

            if LocalPlayer:GetAttribute("QueueLeader") == true then
                pcall(function()
                    Packets.startQuqueNow:fire()
                end)
                if QueueInstantStartConnection then
                    QueueInstantStartConnection:Disconnect()
                    QueueInstantStartConnection = nil
                end
            end
        end

        TryInstantStart()
        if LocalPlayer:GetAttribute("QueueLeader") ~= true then
            QueueInstantStartConnection = LocalPlayer:GetAttributeChangedSignal("QueueLeader"):Connect(TryInstantStart)
        end
    end
end

function ChromaticaInternal.LeaveQueue()
    AutoJoinAssignedRoom = nil

    if QueueInstantStartConnection then
        pcall(function()
            QueueInstantStartConnection:Disconnect()
        end)
        QueueInstantStartConnection = nil
    end

    if not Packets
        or not Packets.leaveQuque
    then
        return
    end

    pcall(function()
        Packets.leaveQuque:
            fire()
    end)
end

function ChromaticaInternal.TriggerAutoJoin()
    if not Toggles.QueueAutoJoin
        or not Toggles.
            QueueAutoJoin.Value
    then
        return
    end

    AutoJoinGeneration =
        AutoJoinGeneration + 1

    local Generation =
        AutoJoinGeneration

    AutoJoinAssignedRoom =
        nil

    task.spawn(function()
        while not Packets
            and not PacketLoadFinished
            and Generation
                == AutoJoinGeneration
            and Toggles.QueueAutoJoin
            and Toggles.
                QueueAutoJoin.Value
        do
            task.wait()
        end

        if Generation
            ~= AutoJoinGeneration
            or not Toggles.QueueAutoJoin
            or not Toggles.
                QueueAutoJoin.Value
            or not Packets
        then
            return
        end

        local SelectedRoom =
            ChromaticaInternal.GetRandomRoom()

        AutoJoinAssignedRoom =
            SelectedRoom

        while Generation
                == AutoJoinGeneration
            and Toggles.QueueAutoJoin
            and Toggles.
                QueueAutoJoin.Value
            and Session
                == getgenv().ChromaticaSession
        do
            if LocalPlayer:
                GetAttribute(
                    "QueueLeader"
                ) ~= true
            then
                ChromaticaInternal.EnterQueueRoom(
                    SelectedRoom
                )
            end

            ChromaticaInternal.StartQueue(
                SelectedRoom
            )

            task.wait(0.5)
        end
    end)
end

function ChromaticaInternal.ClaimAllQuests()
    if not Packets
        or not Packets.claimQuestRewards
        or type(Packets.claimQuestRewards.fire)
            ~= "function"
    then
        return false
    end

    QuestClaimRequestId =
        (QuestClaimRequestId % 65535) + 1

    return pcall(function()
        Packets.claimQuestRewards:fire({
            requestId =
                QuestClaimRequestId
        })
    end)
end

function ChromaticaInternal.StartAutoClaimAllQuests()
    AutoClaimQuestsGeneration =
