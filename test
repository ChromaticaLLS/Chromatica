    local GlobalFolder = PlayerScripts and PlayerScripts:FindFirstChild("global")
    local StoresFolder = GlobalFolder and GlobalFolder:FindFirstChild("stores")
    local ControllersFolder = GlobalFolder and GlobalFolder:FindFirstChild("controllers")

