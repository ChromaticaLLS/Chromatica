-- Refresh queue modes/maps from the live enum so newly added game modes and map IDs
-- are represented without replacing the current Auto Raid/farm implementation.
do
    local Module
    local Success = pcall(function()
        local Lobby = ReplicatedStorage:FindFirstChild("lobby") or ReplicatedStorage:WaitForChild("lobby", 5)
        local Enums = Lobby and (Lobby:FindFirstChild("enums") or Lobby:WaitForChild("enums", 5))
        local EnumModule = Enums and (Enums:FindFirstChild("gamemodeSelectEnum") or Enums:WaitForChild("gamemodeSelectEnum", 5))
        if EnumModule then
            Module = require(EnumModule)
        end
    end)

    if Success and type(Module) == "table" and type(Module.Gamemode) == "table" then
        GamemodeInfo.Enum = Module.Gamemode
        GamemodeInfo.ModeValues = {}
        local Preferred = {"Story", "Defend", "Infinite", "Raid", "Trials"}
        local Added = {}

        for _, ModeId in ipairs(Preferred) do
            if Module.Gamemode[ModeId] then
                table.insert(GamemodeInfo.ModeValues, ModeId)
                Added[ModeId] = true
            end
        end

        local Remaining = {}
        for ModeId, Mode in pairs(Module.Gamemode) do
            if type(ModeId) == "string" and not Added[ModeId] and type(Mode) == "table" then
                table.insert(Remaining, ModeId)
            end
        end
        table.sort(Remaining)
        for _, ModeId in ipairs(Remaining) do
            table.insert(GamemodeInfo.ModeValues, ModeId)
        end

        for ModeId, Mode in pairs(Module.Gamemode) do
            if type(ModeId) ~= "string" or type(Mode) ~= "table" then
                continue
            end

            local Info = GamemodeInfo[ModeId] or {}
            GamemodeInfo[ModeId] = Info
            Info.ModeData = Mode
            Info.Maps = {}
            Info.MapIds = Info.MapIds or {}
            Info.MapNames = Info.MapNames or {}

            for _, MapData in pairs(Mode.Maps or {}) do
                if type(MapData) == "table" and MapData.Id and MapData.StudioOnly ~= true then
                    table.insert(Info.Maps, MapData)
                    Info.MapIds[MapData.DisplayName or tostring(MapData.Id)] = MapData.Id
                    Info.MapNames[MapData.Id] = MapData.DisplayName or tostring(MapData.Id)
                end
            end

            table.sort(Info.Maps, function(A, B)
                return tostring(A.DisplayName or A.Id) < tostring(B.DisplayName or B.Id)
            end)

            local DesiredId = Info.SelectedMap or Info.Map
            local SelectedMapData
            for _, MapData in ipairs(Info.Maps) do
                if MapData.Id == DesiredId then
                    SelectedMapData = MapData
                    break
                end
            end

            if not SelectedMapData and ModeId == "Trials" then
                for _, MapData in ipairs(Info.Maps) do
                    if MapData.Floors then
                        SelectedMapData = MapData
                        break
                    end
                end
            end

            if not SelectedMapData then
                SelectedMapData = Info.Maps[1]
            end

            if SelectedMapData then
                Info.MapData = SelectedMapData
                Info.Map = SelectedMapData.Id
                Info.SelectedMap = SelectedMapData.Id
            end
        end
    else
        GamemodeInfo.ModeValues = {"Story", "Infinite", "Raid", "Trials"}
    end
end

