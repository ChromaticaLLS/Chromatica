function ChromaticaInternal.GetSilentMouseAimPart()
    local Env = getgenv()
    local AutoMoveTarget = Env.ChromaticaAutoMoveAimTarget

    if os.clock() <= (Env.ChromaticaAutoMoveAimUntil or 0)
        and AutoMoveTarget
        and AutoMoveTarget.Parent
    then
        return AutoMoveTarget
    end

    if RaidCurrentTarget
        and RaidCurrentTarget.Parent
        and not ChromaticaInternal.IsIgnoredHighlightedRaidBoss(
            RaidCurrentTarget
        )
        and ChromaticaInternal.IsEnemyAlive(
            RaidCurrentTarget
        )
    then
        local Root =
            ChromaticaInternal.GetEnemyRoot(
                RaidCurrentTarget
            )

        if Root then
            return Root
        end
    end

    if CurrentMobTarget
        and CurrentMobTarget.Parent
        and ChromaticaInternal.IsEnemyAlive(
            CurrentMobTarget
        )
    then
        local Root =
            ChromaticaInternal.GetEnemyRoot(
                CurrentMobTarget
            )

        if Root then
            return Root
        end
    end

    if CurrentGateTarget
        and CurrentGateTarget.Parent
    then
        if CurrentGateTarget:IsA(
            "BasePart"
        ) then
            return CurrentGateTarget
        end

        local Part =
            CurrentGateTarget:
                FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

        if Part then
            return Part
        end
    end

    local Enemy = nil

    if Toggles.RaidAutoFarm
        and Toggles.RaidAutoFarm.Value
    then
        Enemy =
            ChromaticaInternal.GetNearestRaidEnemy()
    else
        Enemy =
            ChromaticaInternal.GetNearestEnemy()
    end

    if Enemy then
        return ChromaticaInternal.GetEnemyRoot(Enemy)
    end

    return nil
end

do
    local Env = getgenv()

    Env.ChromaticaMouseAimObject =
        LocalPlayer:GetMouse()

    Env.ChromaticaMouseAimProvider =
        ChromaticaInternal.GetSilentMouseAimPart

    if not Env.ChromaticaMouseAimHookInstalled then
        local HookMetamethod =
            hookmetamethod

        local NewCClosure =
            newcclosure

        if type(HookMetamethod)
            == "function"
        then
            local OldIndex

            local function IndexHook(
                Self,
                Key
            )
                local CurrentEnv =
                    getgenv()

                if Self
                    == CurrentEnv.
                        ChromaticaMouseAimObject
                then
                    local Provider =
                        CurrentEnv.
                            ChromaticaMouseAimProvider

                    if type(Provider)
                        == "function"
                    then
                        local Success,
                            TargetPart =
                            pcall(Provider)

                        if Success
                            and TargetPart
                            and TargetPart.Parent
                        then
                            if Key == "Hit" then
                                return TargetPart.CFrame
                            end

                            if Key == "Target" then
                                return TargetPart
                            end

                            if Key == "UnitRay" then
                                local Camera =
                                    workspace.
                                        CurrentCamera

                                if Camera then
                                    local Origin =
                                        Camera.CFrame.
                                            Position

                                    local Direction =
                                        TargetPart.Position
                                        - Origin

                                    if Direction.Magnitude
                                        > 0
                                    then
                                        return Ray.new(
                                            Origin,
                                            Direction.Unit
                                                * 1000
                                        )
                                    end
                                end
                            end
                        end
                    end
                end

                return OldIndex(
                    Self,
                    Key
                )
            end

            if type(NewCClosure)
                == "function"
            then
                OldIndex =
                    HookMetamethod(
                        game,
                        "__index",
                        NewCClosure(
                            IndexHook
                        )
                    )
            else
                OldIndex =
                    HookMetamethod(
                        game,
                        "__index",
                        IndexHook
                    )
            end

            Env.ChromaticaMouseAimHookInstalled =
                true
        end
    end

    Library:OnUnload(function()
        if getgenv().
            ChromaticaSession
            == Session
        then
            Env.ChromaticaMouseAimProvider =
                nil

            Env.ChromaticaAutoMoveAimTarget = nil
            Env.ChromaticaAutoMoveAimUntil = 0
        end
    end)
end

function ChromaticaInternal.GetFarmCFrame(
    EnemyRoot,
    DeltaTime
)
    if FarmMethod == "Behind" then
        local Position =
            EnemyRoot.Position
            - EnemyRoot.CFrame.LookVector
            * FarmDistance

        return CFrame.new(
            Position,
            EnemyRoot.Position
        )
    end

    if FarmMethod == "Below" then
        local Position =
            EnemyRoot.Position
            - Vector3.new(
                0,
                FarmDistance,
                0
            )

        return CFrame.new(
            Position,
            EnemyRoot.Position
        )
    end

    if FarmMethod == "Above" then
        local Position =
            EnemyRoot.Position
            + Vector3.new(
                0,
                FarmDistance,
                0
            )
            - EnemyRoot.CFrame.LookVector
            * 5

        return CFrame.new(
            Position,
            EnemyRoot.Position
        )
    end

    if FarmMethod == "Orbit" then
        OrbitAngle =
            OrbitAngle
            + DeltaTime
            * OrbitSpeed

        local Offset =
            Vector3.new(
                math.cos(OrbitAngle)
                    * FarmDistance,
                0,
                math.sin(OrbitAngle)
                    * FarmDistance
            )

        local Position =
            EnemyRoot.Position
            + Offset

        return CFrame.new(
            Position,
            EnemyRoot.Position
        )
    end

    return EnemyRoot.CFrame
end

function ChromaticaInternal.GetRaidAboveCFrame(
    EnemyRoot,
    Distance
)
    local Position =
        EnemyRoot.Position
        + Vector3.new(
            0,
            Distance,
            0
        )
        - EnemyRoot.CFrame.LookVector
        * 5

    return CFrame.new(
        Position,
        EnemyRoot.Position
    )
end

function ChromaticaInternal.GetRaidExit()
    local World =
        workspace:FindFirstChild(
            "World"
        )

    if not World then
        return nil
    end

    local Markers =
        World:FindFirstChild(
            "Markers"
        )

    if not Markers then
        return nil
    end

    return Markers:FindFirstChild(
        "Exit"
    )
end

function ChromaticaInternal.GetRaidExitPrompt()
    local Exit =
        ChromaticaInternal.GetRaidExit()

    if not Exit then
        return nil, nil
    end

    local Prompt =
        Exit:FindFirstChild(
            "ExitPrompt",
            true
        )

    if Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
    then
        return Exit, Prompt
    end

    for _, Object in ipairs(
        Exit:GetDescendants()
    ) do
        if Object:IsA(
            "ProximityPrompt"
        )
            and Object.Name
                == "ExitPrompt"
        then
            return Exit, Object
        end
    end

    return Exit, nil
end

function ChromaticaInternal.GetRaidPromptTarget(
    Prompt
)
    if not Prompt then
        return nil
    end

    local Current =
        Prompt.Parent

    while Current
        and Current ~= workspace
    do
        if Current:IsA(
            "Attachment"
        ) then
            return Current
        end

        if Current:IsA(
            "BasePart"
        ) then
            return Current
        end

        Current =
            Current.Parent
    end

    return nil
end

function ChromaticaInternal.UseRaidExitPrompt(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
    then
        return false
    end

    if fireproximityprompt then
        pcall(function()
            fireproximityprompt(
                Prompt
            )
        end)

        return true
    end

    pcall(function()
        Prompt:InputHoldBegin()

        task.delay(
            math.max(
                Prompt.HoldDuration,
                0
            ) + 0.05,

            function()
                if Prompt
                    and Prompt.Parent
                    and Prompt.Enabled
                then
                    pcall(function()
                        Prompt:InputHoldEnd()
                    end)
                end
            end
        )
    end)

    return true
end

