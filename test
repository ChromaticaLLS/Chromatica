function ChromaticaInternal.StartRolling()
    RollingGeneration =
        RollingGeneration + 1

    local Generation =
        RollingGeneration

    task.spawn(function()
        while Generation
            == RollingGeneration
        do
            if Session
                ~= getgenv().
                    ChromaticaSession
            then
                return
            end

            if not Toggles.RollingAutoRoll
                or not Toggles.
                    RollingAutoRoll.Value
            then
                return
            end

            if not Packets
                or not Packets.
                    rollCharacter
            then
                if PacketLoadFinished then
                    Toggles.RollingAutoRoll:
                        SetValue(false)

                    return
                end

                task.wait(0.1)
                continue
            end

            local Slot =
                RollingSelectedSlot

            local RequestId =
                ChromaticaInternal.NextRollingRequestId()

            RollingPendingRequestId =
                RequestId

            RollingPendingSlot =
                Slot

            RollingPendingResult =
                nil

            local SpinType =
                RollingSpinType

            local PaymentCurrency =
                SpinType == "Lucky"
                and "luckySpins"
                or "rolls"

            local Success =
                pcall(function()
                    Packets.rollCharacter:
                        fire({
                            spinType = SpinType,
                            paymentCurrency = PaymentCurrency,
                            slot = Slot,
                            requestId = RequestId
                        })
                end)

            if not Success then
                Toggles.RollingAutoRoll:
                    SetValue(false)

                return
            end

            local Deadline =
                os.clock()
                + RollingTimeout

            while Generation
                == RollingGeneration
                and Toggles.RollingAutoRoll
                and Toggles.
                    RollingAutoRoll.Value
                and not RollingPendingResult
                and os.clock() < Deadline
            do
                task.wait(0.2)
            end

            if Generation
                ~= RollingGeneration
            then
                return
            end

            if not Toggles.RollingAutoRoll
                or not Toggles.
                    RollingAutoRoll.Value
            then
                return
            end

            local Result =
                RollingPendingResult

            RollingPendingRequestId =
                nil

            RollingPendingSlot =
                nil

            RollingPendingResult =
                nil

            if not Result then
                Toggles.RollingAutoRoll:
                    SetValue(false)

                return
            end

            if not Result.success then
                Toggles.RollingAutoRoll:
                    SetValue(false)

                return
            end

            if ChromaticaInternal.IsStopCharacter(
                Result.character
            )
            then
                Toggles.RollingAutoRoll:
                    SetValue(false)

                return
            end

            local WaitUntil =
                os.clock()
                + RollingDelay

            while Generation
                == RollingGeneration
                and Toggles.RollingAutoRoll
                and Toggles.
                    RollingAutoRoll.Value
                and os.clock()
                    < WaitUntil
            do
                task.wait(0.2)
            end
        end
    end)
end

