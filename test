                                PreviousChanged
                            ) == "function"
                            then
                                pcall(
                                    PreviousChanged,
                                    Value
                                )
                            end

                            QueueAutoSave()
                        end
                    )
                end)
            end
        end
    end

    if AutoSaveEnabled then
        pcall(function()
            SaveManager:Load(
                "autosave"
            )
        end)
    else
        pcall(function()
            SaveManager:
                LoadAutoloadConfig()
        end)
    end

