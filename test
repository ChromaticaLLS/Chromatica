do
    local Env = getgenv()
    Env.ChromaticaAutoMoveAimUntil = 0
    Env.ChromaticaAutoMoveAimTarget = nil

    if not Env.ChromaticaAutoMoveAimNamecallHookInstalled
        and type(hookmetamethod) == "function"
        and type(getnamecallmethod) == "function"
    then
        local OldNamecall

        local function NamecallHook(Self, ...)
            local Method = getnamecallmethod()
            local Args = {...}
            local CallerIsExecutor = false

            if type(checkcaller) == "function" then
                local Success, Result = pcall(checkcaller)
                CallerIsExecutor = Success and Result or false
            end

            if not CallerIsExecutor
                and os.clock() <= (Env.ChromaticaAutoMoveAimUntil or 0)
            then
                local TargetPart = Env.ChromaticaAutoMoveAimTarget

                if TargetPart and TargetPart.Parent then
                    if Self == workspace and Method == "Raycast" then
                        local Origin = Args[1]
                        local Direction = Args[2]

                        if typeof(Origin) == "Vector3"
                            and typeof(Direction) == "Vector3"
                        then
                            local Delta = TargetPart.Position - Origin

                            if Delta.Magnitude > 0 then
                                Args[2] = Delta.Unit * math.max(Direction.Magnitude, 1000)
                                return OldNamecall(Self, table.unpack(Args))
                            end
                        end
                    elseif Self == workspace
                        and (
                            Method == "FindPartOnRay"
                            or Method == "FindPartOnRayWithIgnoreList"
                            or Method == "FindPartOnRayWithWhitelist"
                        )
                    then
                        local RayArg = Args[1]

                        if typeof(RayArg) == "Ray" then
                            local Origin = RayArg.Origin
                            local Delta = TargetPart.Position - Origin

                            if Delta.Magnitude > 0 then
                                Args[1] = Ray.new(
                                    Origin,
                                    Delta.Unit * math.max(RayArg.Direction.Magnitude, 1000)
                                )
                                return OldNamecall(Self, table.unpack(Args))
                            end
                        end
                    elseif Self == workspace.CurrentCamera
                        and (
                            Method == "ViewportPointToRay"
                            or Method == "ScreenPointToRay"
                        )
                    then
                        local Camera = workspace.CurrentCamera

                        if Camera then
                            local Origin = Camera.CFrame.Position
                            local Delta = TargetPart.Position - Origin

                            if Delta.Magnitude > 0 then
                                return Ray.new(Origin, Delta.Unit * 1000)
                            end
                        end
                    end
                end
            end

            return OldNamecall(Self, ...)
        end

        if type(newcclosure) == "function" then
            OldNamecall = hookmetamethod(game, "__namecall", newcclosure(NamecallHook))
        else
            OldNamecall = hookmetamethod(game, "__namecall", NamecallHook)
        end

        Env.ChromaticaAutoMoveAimNamecallHookInstalled = true
    end
end

