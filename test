                end)
            end
        )
    end

    local function HookAutoSave()
        for Index, Toggle in pairs(
            Toggles
        ) do
            if Index ~= "AutoSave" then
                pcall(function()
                    local PreviousChanged =
                        Toggle.Changed

                    Toggle:OnChanged(
                        function(Value)
                            if type(
                                PreviousChanged
                            ) == "function"
                            then
                                pcall(
                                    PreviousChanged,
                                    Value
                                )
                            end

                            QueueAutoSave()
                        end
                    )
                end)
            end
        end

        for Index, Option in pairs(
            Options
        ) do
            if Index ~= "MenuKeybind"
                and not string.find(
                    tostring(Index),
                    "^SaveManager_"
                )
            then
                pcall(function()
                    local PreviousChanged =
                        Option.Changed

                    Option:OnChanged(
                        function(Value)
