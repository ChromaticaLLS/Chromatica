                end)
            end

            return
        end

        if Object:IsA("PostEffect") then
            pcall(function()
                Object:Destroy()
            end)

            return
        end

        if Super then
            if Object:IsA("SpecialMesh")
                or Object:IsA("Atmosphere")
                or Object:IsA("Sky")
                or Object:IsA("Clouds")
                or Object:IsA("Highlight")
            then
                pcall(function()
                    Object:Destroy()
                end)

                return
            end

            if Object:IsA("PointLight")
                or Object:IsA("SpotLight")
                or Object:IsA("SurfaceLight")
