function ChromaticaInternal.GetObjectCFrame(Object)
    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.CFrame
    end

    if Object:IsA("Attachment") then
        return Object.WorldCFrame
    end

    if Object:IsA("Model") then
        local Success, Pivot = pcall(function()
            return Object:GetPivot()
        end)

        if Success then
            return Pivot
        end
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Part then
        return Part.CFrame
    end

    return nil
end

function ChromaticaInternal.CancelMovementTween()
    if MovementTween then
        pcall(function()
            MovementTween:Cancel()
        end)
    end

    MovementTween = nil
    MovementTweenRoot = nil
    MovementTweenTarget = nil
    MovementTweenLastStart = 0
end

function ChromaticaInternal.TweenRootTo(TargetCFrame, Speed)
    local Root = ChromaticaInternal.GetCharacterRoot()

    if not Root
        or typeof(TargetCFrame) ~= "CFrame"
    then
        return false
    end

    local Now = os.clock()
    local TargetPosition =
        TargetCFrame.Position

    if MovementTween
        and MovementTweenRoot == Root
        and MovementTweenTarget
        and (
            MovementTweenTarget.Position
            - TargetPosition
        ).Magnitude <= MovementTweenRetargetDistance
        and Now - MovementTweenLastStart
            < MovementTweenRetargetDelay
    then
        return true
    end

    local Distance =
        (
            Root.Position
            - TargetPosition
        ).Magnitude

    if Distance <= 0.15 then
        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

        Root.CFrame = TargetCFrame
        return true
    end

    if MovementTween then
        pcall(function()
            MovementTween:Cancel()
        end)
    end

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    local MoveSpeed =
        TweenMoveSpeed

    MoveSpeed =
        math.max(
            MoveSpeed,
            1
        )

    local Duration =
        math.clamp(
            Distance / MoveSpeed,
            0.05,
            8
        )

    local TweenValue =
        Instance.new("CFrameValue")

    TweenValue.Value = Root.CFrame

    local Tween =
        TweenService:Create(
            TweenValue,
            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                Value = TargetCFrame
            }
        )

    MovementTween = Tween
    MovementTweenRoot = Root
    MovementTweenTarget = TargetCFrame
    MovementTweenLastStart = Now

    Tween.Completed:Connect(function(PlaybackState)
        if MovementTween == Tween then
            if PlaybackState
                == Enum.PlaybackState.Completed
                and Root.Parent
            then
                Root.AssemblyLinearVelocity =
                    Vector3.zero

                Root.AssemblyAngularVelocity =
                    Vector3.zero

                Root.CFrame = TargetCFrame
            end

            MovementTween = nil
            MovementTweenRoot = nil
        end

        pcall(function()
            TweenValue:Destroy()
        end)
    end)

    Tween:Play()

    task.spawn(function()
        while MovementTween == Tween
            and MovementTweenRoot == Root
            and Root.Parent
        do
            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero

            local Humanoid =
                Root.Parent:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Humanoid then
                Humanoid:Move(
                    Vector3.zero,
                    false
                )
            end

            Root.CFrame = TweenValue.Value

            RunService.RenderStepped:Wait()
        end

        pcall(function()
            TweenValue:Destroy()
        end)
    end)

    return true
end

function ChromaticaInternal.TeleportToObject(Object, YOffset)
    local Root = ChromaticaInternal.GetCharacterRoot()

    if not Root then
        return false
    end

    local TargetCFrame =
        ChromaticaInternal.GetObjectCFrame(Object)

    if not TargetCFrame then
        return false
    end

    local Offset = YOffset

    if Offset == nil then
        Offset = 3
    end

    return ChromaticaInternal.TweenRootTo(
        TargetCFrame
        + Vector3.new(
            0,
            Offset,
            0
        )
    )
end

function ChromaticaInternal.TeleportBehindObject(Object, Distance)
    local Root = ChromaticaInternal.GetCharacterRoot()

    if not Root then
        return false
    end

    local TargetCFrame =
        ChromaticaInternal.GetObjectCFrame(Object)

    if not TargetCFrame then
        return false
    end

    Distance =
        Distance or 3

    local TargetPosition =
        TargetCFrame.Position

    local Position =
        TargetPosition
        - TargetCFrame.LookVector
        * Distance

    return ChromaticaInternal.TweenRootTo(
        CFrame.new(
            Position,
            TargetPosition
        )
    )
end

function ChromaticaInternal.GetEnemyRoot(Enemy)
    if not Enemy then
        return nil
    end

    if Enemy:IsA("BasePart") then
        return Enemy
    end

    if not Enemy:IsA("Model") then
        return nil
    end

    return Enemy:FindFirstChild("HumanoidRootPart")
        or Enemy:FindFirstChild("Torso")
        or Enemy:FindFirstChild("UpperTorso")
        or Enemy.PrimaryPart
        or Enemy:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end

function ChromaticaInternal.IsEnemyAlive(Enemy)
    if not Enemy
        or not Enemy.Parent
    then
        return false
    end

    local Humanoid =
        Enemy:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then
        return Humanoid.Health > 0
    end

    return ChromaticaInternal.GetEnemyRoot(Enemy) ~= nil
end

function ChromaticaInternal.GetNearestEnemy()
    local Enemies =
        workspace:FindFirstChild(
            "enemies"
        )

    if not Enemies then
        return nil
    end

    local Root =
        ChromaticaInternal.GetCharacterRoot()

    if not Root then
        return nil
    end

    local Closest = nil
    local ClosestDistance = math.huge

    for _, Enemy in ipairs(
        Enemies:GetChildren()
    ) do
        if ChromaticaInternal.IsEnemyAlive(Enemy) then
            local EnemyRoot =
                ChromaticaInternal.GetEnemyRoot(Enemy)

            if EnemyRoot then
                local Distance =
                    (
                        Root.Position
                        - EnemyRoot.Position
                    ).Magnitude

                if Distance < ClosestDistance then
                    ClosestDistance =
                        Distance

                    Closest =
                        Enemy
                end
            end
        end
    end

    return Closest
end

