        then
            return
        end

        if not AccountStore then
            Toggles.TraitAutoReroll:
                SetValue(false)

            return
        end

        if not ChromaticaInternal.HasTraitStopSelection() then
            Toggles.TraitAutoReroll:
                SetValue(false)

            return
        end

        while Generation
            == TraitRerollGeneration
        do
            if Session
                ~= getgenv().
                    ChromaticaSession
            then
                return
            end

            if not Toggles.TraitAutoReroll
                or not Toggles.
                    TraitAutoReroll.Value
            then
                return
            end

            if not Packets
                or not Packets.rollTrait
            then
                if PacketLoadFinished then
                    Toggles.TraitAutoReroll:
                        SetValue(false)

                    return
                end

                task.wait(0.1)
                continue
            end

            if not ChromaticaInternal.HasTraitStopSelection() then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            local Character =
                ChromaticaInternal.GetCharacterFromSlot(
                    TraitRerollSelectedSlot
                )

            if not Character then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            local CurrentTraitId =
                ChromaticaInternal.GetCurrentTraitId(
                    Character
                )

            if CurrentTraitId
                and ChromaticaInternal.IsStopTraitId(
                    CurrentTraitId
                )
            then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            local WaitTime =
                TraitRerollDelay
                - (
                    os.clock()
                    - TraitRerollLastRequestAt
                )

            while WaitTime > 0
                and Generation
                    == TraitRerollGeneration
                and Toggles.TraitAutoReroll
                and Toggles.
                    TraitAutoReroll.Value
            do
                task.wait(
                    math.min(
                        WaitTime,
                        0.05
                    )
                )

                WaitTime =
                    TraitRerollDelay
                    - (
                        os.clock()
                        - TraitRerollLastRequestAt
                    )
            end

            if Generation
                ~= TraitRerollGeneration
            then
                return
            end

            if not Toggles.TraitAutoReroll
                or not Toggles.
                    TraitAutoReroll.Value
            then
                return
            end

            local RequestId =
                ChromaticaInternal.NextTraitRerollRequestId()

            TraitRerollPendingRequestId =
                RequestId

            TraitRerollPendingCharacter =
                Character

            TraitRerollPendingResult =
                nil

            TraitRerollLastRequestAt =
                os.clock()

            local Success =
                pcall(function()
                    Packets.rollTrait:
                        fire({
                            character =
                                Character,

                            requestId =
                                RequestId
                        })
                end)

            if not Success then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            local Deadline =
                os.clock()
                + TraitRerollTimeout

            while Generation
                == TraitRerollGeneration
                and Toggles.TraitAutoReroll
                and Toggles.
                    TraitAutoReroll.Value
                and not
                    TraitRerollPendingResult
                and os.clock()
                    < Deadline
            do
                task.wait(0.2)
            end

            if Generation
                ~= TraitRerollGeneration
            then
                return
            end

            if not Toggles.TraitAutoReroll
                or not Toggles.
                    TraitAutoReroll.Value
            then
                return
            end

            local Result =
                TraitRerollPendingResult

            TraitRerollPendingRequestId =
                nil

            TraitRerollPendingCharacter =
                nil

            TraitRerollPendingResult =
                nil

            if not Result then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            if not Result.success then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end

            if ChromaticaInternal.IsStopTraitId(
                Result.traitId
            )
            then
                Toggles.TraitAutoReroll:
                    SetValue(false)

                return
            end
        end
    end)
end

