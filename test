                        UltimateTimer.NextDue = Now
                        UltimateTimer.Pending = false
                        UltimateTimer.Attempting = false
                        UltimateTimer.Confirmed = false
                        UltimateTimer.RetryAt = 0
                        UltimateTimer.CooldownActive = false
                        UltimateTimer.LastCountdownSecond = nil
                        UltimateTimer.LastActivated = 0
                        UltimateTimer.ProcessingTill = 0
                        UltimateTimer.ClearMoveSince = nil
                        print("[Chromatica] Auto Ultimate enabled; waiting for a valid Skill4 cast.")
                    end

                    if not UltimateTimer.Pending
                        and not UltimateTimer.Attempting
                        and not UltimateTimer.Confirmed
                        and Now >= UltimateTimer.NextDue
                    then
                        UltimateTimer.Pending = true
                        UltimateTimer.NextDue = math.huge
                        UltimateTimer.RetryAt = 0
                        UltimateTimer.CooldownActive = false
                        UltimateTimer.LastCountdownSecond = nil

                        if UltimateTimer.LastActivated > 0 then
                            print("[Chromatica] Auto Ultimate: interval elapsed; waiting for the move system to be free.")
                        else
                            print("[Chromatica] Auto Ultimate: first cast ready; waiting for the move system to be free.")
                        end
                    end

                    local MoveAnimationPlaying = ChromaticaInternal.HasActiveMoveAnimation()

                    if UltimateTimer.Confirmed then
                        HoldMoves = true

                        local CurrentSkillTill = ChromaticaInternal.GetCurrentSkillProcessingTill()
                        if CurrentSkillTill > (UltimateTimer.ProcessingTill or 0) then
                            UltimateTimer.ProcessingTill = CurrentSkillTill
                        end

                        if MoveAnimationPlaying
                            or ServerNow < (UltimateTimer.ProcessingTill or 0)
                        then
                            UltimateTimer.ClearMoveSince = nil
                        else
                            if not UltimateTimer.ClearMoveSince then
                                UltimateTimer.ClearMoveSince = Now
                            end

                            if Now - UltimateTimer.ClearMoveSince >= 0.18 then
                                UltimateTimer.Confirmed = false
                                UltimateTimer.Pending = false
                                UltimateTimer.Attempting = false
                                UltimateTimer.ProcessingTill = 0
                                UltimateTimer.ClearMoveSince = nil
                                UltimateTimer.CooldownActive = true
                                UltimateTimer.NextDue = Now + UltimateTimer.Interval
                                UltimateTimer.LastCountdownSecond = nil
                                print(("[Chromatica] Ultimate finished; starting %d-second countdown."):format(UltimateTimer.Interval))
                            end
                        end
                    end

                    if UltimateTimer.Pending
                        and CanUseMovesNow
                        and ChromaticaInternal.CanUseAutoUltimate()
                    then
                        if UltimateTimer.Confirmed then
                            HoldMoves = true
                        elseif UltimateTimer.Attempting then
                            if MoveAnimationPlaying then
                                UltimateTimer.Attempting = false
                                UltimateTimer.Pending = false
                                UltimateTimer.Confirmed = true
                                UltimateTimer.LastActivated = Now
                                UltimateTimer.NextDue = math.huge
                                UltimateTimer.CooldownActive = false
                                UltimateTimer.LastCountdownSecond = nil
                                UltimateTimer.ProcessingTill = ChromaticaInternal.GetCurrentSkillProcessingTill()
                                UltimateTimer.ClearMoveSince = nil
                                HoldMoves = true
                                print("[Chromatica] Auto Ultimate: detected the new action animation; waiting for it to finish.")
                            elseif Now - UltimateTimer.AttemptAt >= 1.25 then
                                UltimateTimer.Attempting = false
                                UltimateTimer.RetryAt = Now + 0.4
                                print("[Chromatica] Auto Ultimate: no accepted Skill4 event or action animation yet; it will retry when the move system is ready.")
                            else
                                HoldMoves = true
                            end
                        elseif MoveAnimationPlaying
                            or ChromaticaInternal.IsUltimateGameStateBusy()
                        then
                            HoldMoves = true
                        elseif Now >= UltimateTimer.RetryAt then
                            local Triggered = ChromaticaInternal.TriggerAction("Skill4")
                            if Triggered then
                                UltimateTimer.Attempting = true
                                UltimateTimer.AttemptAt = Now
                                HoldMoves = true
                                print("[Chromatica] Auto Ultimate: requested Skill4 (G); waiting for game confirmation.")
                            else
                                UltimateTimer.RetryAt = Now + 0.35
                                HoldMoves = true
                                print("[Chromatica] Auto Ultimate: unable to send Skill4; will retry shortly.")
                            end
                        else
                            HoldMoves = true
                        end
                    end

                    if UltimateTimer.CooldownActive
                        and not UltimateTimer.Pending
                        and not UltimateTimer.Attempting
                        and not UltimateTimer.Confirmed
                    then
                        local CountdownSeconds = math.max(
                            0,
                            math.ceil(UltimateTimer.NextDue - Now)
                        )

                        if CountdownSeconds > 0 then
                            if UltimateTimer.LastCountdownSecond ~= CountdownSeconds then
                                print(("[Chromatica] Auto Ultimate: %d seconds until next ultimate."):format(CountdownSeconds))
                                UltimateTimer.LastCountdownSecond = CountdownSeconds
                            end
                        elseif UltimateTimer.LastCountdownSecond ~= 0 then
                            print("[Chromatica] Auto Ultimate: 0 seconds remaining.")
                            UltimateTimer.LastCountdownSecond = 0
                        end
                    end
                end

                if not CanUseMovesNow then
                    return
                end

                if HoldMoves then
                    return
                end

                if Toggles.AutoM1
                    and Toggles.AutoM1.Value
                    and Now - LastM1 >= MoveDelay
                then
                    LastM1 = Now
                    ChromaticaInternal.PerformM1()
                end

                if Toggles.AutoSkill1
