    if not LocalStoreModule then
        local StarterPlayer = game:GetService("StarterPlayer")
        local StarterScripts = StarterPlayer and StarterPlayer:FindFirstChild("StarterPlayerScripts")
        local StarterGlobal = StarterScripts and StarterScripts:FindFirstChild("global")
        local StarterStores = StarterGlobal and StarterGlobal:FindFirstChild("stores")
        LocalStoreModule = StarterStores and StarterStores:FindFirstChild("localPlayerStore")
    end

    if LocalStoreModule and not UltimateTimer.LocalPlayerStoreModule then
        local Success, Result = pcall(function()
            return require(LocalStoreModule)
        end)
        if Success and type(Result) == "table" then
            UltimateTimer.LocalPlayerStoreModule = Result
        end
    end

    local GameFolder = ReplicatedStorage:FindFirstChild("game")
    local GameStores = GameFolder and GameFolder:FindFirstChild("stores")
    local PlayerNamespace = GameStores and GameStores:FindFirstChild("playerNamespace")
    if PlayerNamespace and not UltimateTimer.PlayerNamespaceModule then
        local Success, Result = pcall(function()
            return require(PlayerNamespace)
        end)
        if Success and type(Result) == "table" then
            UltimateTimer.PlayerNamespaceModule = Result
        end
    end

    local RunStore = GameStores and GameStores:FindFirstChild("runStore")
    if RunStore and not UltimateTimer.RunStoreModule then
        local Success, Result = pcall(function()
            return require(RunStore)
        end)
        if Success and type(Result) == "table" then
            UltimateTimer.RunStoreModule = Result
        end
    end

    local GameControllers = GameFolder and GameFolder:FindFirstChild("controllers")
    local MouseAim = GameControllers and GameControllers:FindFirstChild("MouseAim")
    if not MouseAim and PlayerScripts then
        local PlayerGameFolder = PlayerScripts:FindFirstChild("game")
        local PlayerGameControllers = PlayerGameFolder and PlayerGameFolder:FindFirstChild("controllers")
        MouseAim = PlayerGameControllers and PlayerGameControllers:FindFirstChild("MouseAim")
    end
    if not MouseAim then
        local StarterPlayer = game:GetService("StarterPlayer")
        local StarterScripts = StarterPlayer and StarterPlayer:FindFirstChild("StarterPlayerScripts")
        local StarterGame = StarterScripts and StarterScripts:FindFirstChild("game")
        local StarterGameControllers = StarterGame and StarterGame:FindFirstChild("controllers")
        MouseAim = StarterGameControllers and StarterGameControllers:FindFirstChild("MouseAim")
    end
    if MouseAim and not UltimateTimer.MouseAimModule then
        local Success, Result = pcall(function()
            return require(MouseAim)
        end)
        if Success and type(Result) == "table" then
            UltimateTimer.MouseAimModule = Result
        end
    end

    local InputController = ControllersFolder and ControllersFolder:FindFirstChild("inputController")
    if not InputController then
        local StarterPlayer = game:GetService("StarterPlayer")
        local StarterScripts = StarterPlayer and StarterPlayer:FindFirstChild("StarterPlayerScripts")
        local StarterGlobal = StarterScripts and StarterScripts:FindFirstChild("global")
        local StarterControllers = StarterGlobal and StarterGlobal:FindFirstChild("controllers")
