function ChromaticaInternal.TriggerAction(
    ActionName
)
    local KeyCode = nil

    if ActionName == "Skill1" then
        KeyCode = Enum.KeyCode.One
    elseif ActionName == "Skill2" then
        KeyCode = Enum.KeyCode.Two
    elseif ActionName == "Skill3" then
        KeyCode = Enum.KeyCode.Three
    elseif ActionName == "Skill4" then
        KeyCode = Enum.KeyCode.G
    elseif ActionName == "Skill5" then
        KeyCode = Enum.KeyCode.Four
    end

    if type(getgenv().ChromaticaBeginAutoMoveSilentAim) == "function" then
        pcall(getgenv().ChromaticaBeginAutoMoveSilentAim)
    end

    if UniversalSupport then
        local Success, Action = pcall(function()
            return UniversalSupport:GetAction(
                ActionName,
                "Idle"
            )
        end)

        if Success and Action then
            local Triggered = false

            if type(Action.PressedCallback) == "function" then
                Triggered = pcall(Action.PressedCallback) or Triggered
            end

            if type(Action.ReleasedCallback) == "function" then
                task.delay(0.03, function()
                    if Session ~= getgenv().ChromaticaSession then
                        return
                    end

                    if type(Action.ReleasedCallback) == "function" then
                        pcall(Action.ReleasedCallback)
                    end
                end)
            end

            if Triggered then
                return true
            end
        end
    end

    if KeyCode then
        local InputSuccess = pcall(function()
            local InputManager = game:GetService("VirtualInputManager")

            InputManager:SendKeyEvent(
                true,
                KeyCode,
                false,
                game
            )

            task.wait(0.03)

            InputManager:SendKeyEvent(
                false,
                KeyCode,
                false,
                game
            )
        end)

        if InputSuccess then
            return true
        end
    end

    return false
end

